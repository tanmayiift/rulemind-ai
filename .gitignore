.DS_Store
.env
.env.local
# Provider keys for the opt-in live-AI suite (#123) and anything else that reads a real
# credential. `.env.*` catches every variant so a new one cannot be added un-ignored by
# accident -- the two lines above were exact matches, and an `.env.ai` would have been tracked.
# The .example files are the documented shape and are committed on purpose.
.env.*
!.env.example
!.env.*.example
.turbo
.mypy_cache/
.ruff_cache/
.next
# The e2e server's own build dir -- see NEXT_DIST_DIR in playwright.config.ts. Separate from
# .next so a Playwright run cannot leave the dev server's client bundle pointing at the
# throwaway e2e API.
.next-e2e

# next-env.d.ts is GENERATED, and in this repo it churns. Next rewrites its `<reference path>` to
# whichever distDir the last `next dev` used, so it flips between .next and .next-e2e every time
# anyone runs the e2e suite -- and the flipped version is wrong for a fresh clone, where
# .next-e2e does not exist yet.
#
# Next's docs say to commit it. That advice assumes one build directory; this repo deliberately
# has two (see NEXT_DIST_DIR in playwright.config.ts), which is what makes the file
# environment-dependent rather than a constant. The half that actually matters -- resolving typed
# routes -- lives in tsconfig.json's `include`, which lists BOTH directories and does not move.
# Verified: `tsc --noEmit` passes with the file absent, because Next regenerates it on any build.
apps/web/next-env.d.ts
dist
coverage
node_modules
.runtime
__pycache__
.pytest_cache
*.pyc

# Android
*.apk
.gradle/
local.properties
**/build/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# Lockfiles: COMMIT them for applications, ignore them for published libraries
# (dart.dev's guidance, and the same split applies to Cargo). The previous blanket `*.lock`
# also swallowed both Cargo.lock files, so nothing in this repo pinned a Rust dependency
# graph -- and pnpm-lock.yaml was the only tracked lockfile of any kind.
packages/sdk-flutter/pubspec.lock
packages/flutter-ui/pubspec.lock

# Test artifacts
test-results/
# Playwright's HTML report. It only started existing on 2026-09-14 -- before that no `reporter:`
# was configured, so CI's default (`dot`) produced nothing and sdk-verify.yml uploaded a path
# that could never have been there. Now that it is real, keep it out of the repo: it is ~500KB
# of generated HTML per run.
playwright-report/

# IDE
*.iml
.idea/

# Rust build artifacts
packages/rulemind-core-rs/target/
target/

# Python venv / caches
**/.venv/
.venv-rulemind/
**/__pycache__/

# wasm-pack build outputs
packages/rulemind-core-rs/pkg/
packages/rulemind-core-rs/pkg-node/
apps/python-executor/data/

# Runtime output from qa/mobile_e2e/start_fastapi.sh — was tracked, so every
# local backend run dirtied the tree and blocked branch switches.
qa/results/mobile-e2e-backend.log
qa/results/mobile-e2e-backend.pid

# The live alert destination. `.example` is committed; the real URL is a credential and must not
# be — that is the whole reason paging reads it from a file instead of from this repo.
observability/secrets/*
!observability/secrets/*.example
!observability/secrets/README.md
