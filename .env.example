# RuleMind — environment reference.
#
# Generated from the code that actually reads these values (`os.environ` /
# `os.getenv` in apps/python-executor/app) plus docker-compose.yml. Values shown
# after "default:" are the in-code fallbacks, so anything you leave unset behaves
# as documented here.
#
# Nothing below is required for a local run: with no .env at all the API boots on
# SQLite with dev secrets. The SECRETS block is the one you must set for anything
# reachable by other people.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development                     # default: development. "production" hardens session cookies.
DATABASE_URL=sqlite:///.runtime/rulemind_v4.db   # default: this. Postgres: postgresql://user:pass@host:5432/rulemind
# libpq GSSAPI encryption. Unset = disabled on every connect (nothing here uses Kerberos); set it
# (e.g. prefer) only if your Postgres authenticates with Kerberos.
PGGSSENCMODE=
REDIS_URL=redis://localhost:6379/0       # optional. Unset = in-process fallbacks for rate limiting / pub-sub.
AUTH_MODE=apikey                         # none | apikey | jwt. NOTE: unset is NOT "none" — auth stays on.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# SECRETS — override every one of these outside local development
# ---------------------------------------------------------------------------
RULEMIND_CONFIG_KEY=rulemind-dev-master-key            # master key for config + decision encryption
# Previous key(s), comma-separated, used for DECRYPT ONLY. Set this before rotating
# RULEMIND_CONFIG_KEY so already-encrypted rows keep reading, then run
# `python scripts/rotate_config_key.py` to re-encrypt them under the new primary, then
# remove this. Blank entries are dropped -- an empty key would derive a publicly
# computable one. Rotating without this makes every encrypted column unreadable.
RULEMIND_CONFIG_KEY_OLD=
# Allow booting on SQLite outside local dev. Off by default: DATABASE_URL being unset or
# blank now refuses to start rather than silently falling back to a single-writer file
# database, which is the failure that looks like "it deployed fine" until the second pod.
RULEMIND_ALLOW_SQLITE=0

# ── Abuse control ──────────────────────────────────────────────────────────────
# Pre-auth, IP-keyed budgets. These run BEFORE authentication, because the paths they
# cover have no authenticated tenant to key on: /onboarding/signup mints a live API key
# for anyone, and /api/admin/v1 sits outside the tenant middleware entirely.
#
# MUST be set behind an ingress or load balancer. At 0 the client IP is the socket peer,
# which behind a proxy is the PROXY -- so every IP-keyed budget collapses into one shared
# bucket and a busy cluster 429s legitimate signups. Set it to the number of proxy hops you
# control; the Nth-from-the-right X-Forwarded-For entry is then used.
RULEMIND_TRUSTED_PROXY_HOPS=0

RULEMIND_SIGNUP_RATE_LIMIT_PER_MIN=20    # 0 disables. A rate limit does not FIX signup abuse.
RULEMIND_SELF_SERVE_SIGNUP=1             # 0 closes the faucet entirely -- the real answer
RULEMIND_ADMIN_RATE_LIMIT_PER_MIN=60
RULEMIND_LOGIN_RATE_LIMIT_PER_MIN=20

# Login lockout. Checked BEFORE bcrypt runs, so a locked account cannot be used for CPU
# exhaustion either. locked_until is set once on crossing the threshold and is NOT extended
# by further failures -- otherwise an attacker could pin a real user out indefinitely.
RULEMIND_LOGIN_MAX_ATTEMPTS=5
RULEMIND_LOGIN_LOCKOUT_SECONDS=900
RULEMIND_LOGIN_ALERT_AFTER=3             # emits a login_failed_repeatedly audit event
#
# The counter is tiered: REDIS_URL when set, then the database (`login_attempts`), then a
# per-process dict as a last resort. Only the first two are real lockouts — the dict resets on
# restart and is not shared, so N replicas give an attacker N times the attempts. There is
# nothing to configure here; the database tier needs no setting and is always available.

# ── Per-resource rate limits ───────────────────────────────────────────────────
# The authenticated limiter used to key on the TENANT alone, so every route shared one bucket:
# a dashboard polling a cheap read consumed the same budget as /decide and could take
# production decisioning offline for that tenant. Requests are now classified
# (decision / read / write / ai / export / admin / unclassified), each with its own bucket.
RATE_LIMIT_PER_CLASS=1                   # 0 collapses back to the single tenant bucket
RATE_LIMIT_AGGREGATE=1                   # 0 keeps only the class buckets

# Class budgets default to a SHARE of the tenant's limit, so a plan upgrade raises all of them
# and a free tenant does not get an enterprise-shaped AI allowance. Shares deliberately sum to
# more than 1.0 -- the aggregate bucket is what stops a client running every class flat out.
#   decision 1.00  read 0.50  write 0.25  admin 0.10  export 0.10  ai 0.05  unclassified 0.05
# ai is 20x tighter than decisions because a stuck retry loop there lands on the customer's
# LLM provider invoice, not on a latency graph.
# Override per class with either an absolute rate or a share:
#   RATE_LIMIT_RPM_CLASS_DECISION=...    RATE_LIMIT_CLASS_SHARE_DECISION=...
# (CLASS is one of DECISION READ WRITE AI EXPORT ADMIN UNCLASSIFIED)

# Bulk endpoints are charged more than one token: max(4, 1 + bytes/UNIT), capped at MAX_COST.
# Derived from Content-Length, never by reading the body -- buffering a bulk upload in the
# outermost middleware would turn the limiter into a memory amplifier.
RATE_LIMIT_BATCH_UNIT_BYTES=512
RATE_LIMIT_MAX_REQUEST_COST=100

# ── Per-tenant engine_config blocks (set via PUT /api/v1/settings, not env) ─────
# Documented here because they are not discoverable from the code otherwise:
#
#   input_validation: {mode: off|warn|enforce, unknown_keys: ignore|warn|reject,
#                      policies: {<policy_id>: {...}}}
#     Validates nested decision-payload keys against what connectors already declare
#     (schema_paths for required paths, sample_payload for types). Default OFF, because
#     switching a schema check on globally would break every existing integration; `warn`
#     records issues without blocking as the migration step. An UNREADABLE mode resolves to
#     enforce, not off, so a config typo cannot reproduce the fail-open it exists to close.
#
#   workflow_aliases: {"kyc": "pol_v3"} or {"kyc": {dev: ..., prod: ..., default: ...}}
#     Lets a sub-workflow step name its child by a stable alias, so promoting a child
#     dev -> uat -> prod does not require rewriting every parent. The parent's own status
#     selects the arm. An unregistered alias never falls back to a stale ref_id.
#
#   fail_open_on_variable_error: true
#     Opts out of the T1.2 guard that sends a decision to review when an input failed to
#     compute. For an operator who has measured their own exposure; default off.
#
#   compute_only_used_vars: true | false
#     Restricts a decision to the variables the policy can transitively reach. Worth the whole
#     measured +82% on the decision path -- and it is PER TENANT because it is an AUDIT
#     decision, not a performance one: with it on, `computed_variables` records what the policy
#     read rather than every PROMOTED variable in the workspace. (Off, a decision computes and
#     records every promoted variable plus whatever the policy reads; an unpromoted draft that
#     no policy uses is never part of a decision, either way.) A regulated lender reconstructing declines
#     from the recorded set wants everything; a high-volume tenant wants the latency. Same
#     install, different answers.
#     Overrides COMPUTE_ONLY_USED_VARS below, in BOTH directions -- a tenant can keep every
#     promoted variable on an install that defaults it on. Absent means "use the install default".
#     Anything that is not exactly true or "1" leaves the default in place, so a typo cannot
#     silently shrink an audit record.

# ── Outbound action / connector egress (app/egress.py) ────────────────────────
# These are the CEILINGS a tenant's own connector config is clamped to, so a policy author
# cannot set a 10-minute timeout or a 1000-retry loop from the dashboard.
#
# RULEMIND_ACTION_ALLOWED_HOSTS is an explicit allow-list for outbound targets, comma-separated.
# Empty means no host allow-list -- the SSRF pin (refusing private/link-local/metadata ranges)
# still applies, and is not optional.
RULEMIND_ACTION_ALLOWED_HOSTS=
RULEMIND_ACTION_MAX_TIMEOUT_MS=30000
RULEMIND_ACTION_MAX_RETRIES=5
RULEMIND_ACTION_MAX_POLLS=10
RULEMIND_ACTION_MAX_POLL_INTERVAL_MS=10000

# ── PII redaction ──────────────────────────────────────────────────────────────
# strict     = Luhn AND a real issuer prefix AND length 13-19. The issuer requirement is
#              what keeps 13-digit millisecond and 19-digit nanosecond epochs out -- both
#              start "17" and 1 in 10 pass Luhn by chance.
# aggressive = drops the issuer requirement and scans integers too. More false positives,
#              and a false positive silently destroys data a customer needs.
# off        = key matching only.
RULEMIND_PII_VALUE_SCAN=strict
# qualified = also match a trailing token subsequence, so customer_email and
#             applicantCardNumber are covered. exact = whole normalised key only.
RULEMIND_PII_KEY_MATCH=qualified

# ── Observability ──────────────────────────────────────────────────────────────
# LOG_LEVEL is now actually read. Before this it was listed here and consumed by nothing:
# there was no logging configuration at all, so every logger.info was dropped and warnings
# fell through to lastResort with no timestamp, level or logger name.
LOG_LEVEL=INFO
LOG_FORMAT=json                          # json | text
# Required when running more than one uvicorn worker -- which the shipped Dockerfile does
# (--workers 2). Without it a /metrics scrape reports only the worker that answered, so
# counters appear to move backwards and rate() is garbage. Must be per-pod and wiped on
# start -- entrypoint.sh does that once, before the fork.
#
# This was documented here but left EMPTY, and docker-compose.yml did not set it at all,
# so the mode was off in the deployment everybody runs first. Measured on that stack: a
# 10-minute window of rulemind_decisions_total ranged 175,073..280,562 and the counter
# decreased twice. Defaulted on now; blank it only for a genuinely single-process run.
PROMETHEUS_MULTIPROC_DIR=/tmp/prom-multiproc

# ── Redis resilience ───────────────────────────────────────────────────────────
# A HUNG Redis (failover, blackhole) is the common incident, and it is different from a
# refused connection: without a socket timeout every rate-limit check blocks a threadpool
# thread indefinitely until all of them are gone.
REDIS_SOCKET_TIMEOUT=2
REDIS_CONNECT_TIMEOUT=2
REDIS_HEALTH_CHECK_INTERVAL=30
# Cooldown before retrying after a failure. Not a permanent latch -- a 5-second failover must
# not pin the process to the in-process fallback until restart.
REDIS_RETRY_AFTER_SECONDS=30

# Bounds on the in-process fallback caches. Unbounded, these grow for as long as Redis is
# down, which turns an outage into a slow OOM.
RUNTIME_CACHE_MAX_ENTRIES=5000
RATE_LIMIT_LOCAL_BUCKETS=10000
FAST_CACHE_MAX_ENTRIES=256
FAST_CACHE_TTL_SECONDS=5

# ── Decision durability ────────────────────────────────────────────────────────
# The WAL file and its in-memory id sets grew one entry per decision, forever. Compaction
# rewrites the file with only unresolved entries every N appends.
DECISION_WAL_COMPACT_EVERY=500
# /decide returns a decision_id whose row may still be in flight in ANOTHER worker, so a
# point read re-polls briefly rather than 404ing a decision that exists.
DECISION_READ_AFTER_WRITE_MS=500
RULEMIND_ADMIN_JWT_SECRET=rulemind-admin-dev-secret    # signs platform-admin JWTs
RULEMIND_ADMIN_EMAIL=admin@rulemind.local
RULEMIND_ADMIN_PASSWORD=rulemind-admin
RULEMIND_DEV_API_KEY=rm_live_devlocaltenantkey000000000000   # seeded local tenant key

# ---------------------------------------------------------------------------
# AI Copilot — BYO key, one per provider, stored encrypted per tenant
# ---------------------------------------------------------------------------
# Keys are NOT read from here: they are set per tenant through the dashboard
# (Settings -> AI) and encrypted at rest with RULEMIND_CONFIG_KEY. Supported
# providers are anthropic, openai and gemini (see ai.SUPPORTED_PROVIDERS).
# PEM that signs SDK edge bundles, and whose public half is served at
# GET /sdk/v1/signing-key for the SDK to verify what it downloads. Leave this unset
# ONLY in local development: the server then generates a keypair in memory at boot,
# so every replica signs with a different key and every restart invalidates the one
# a device pinned. Set a real key before relying on bundle signatures.
RULEMIND_SIGNING_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Database pool
# ---------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Decision path — logging, durability, encryption
# ---------------------------------------------------------------------------
ASYNC_DECISION_LOG=1                     # 1 = log off the request path (read-after-write preserved)
DECISION_LOG_WORKERS=4
DECISION_LOG_MAX_QUEUE=1000
DECISION_ENCRYPT_AT_REST=1               # encrypt decision payloads using RULEMIND_CONFIG_KEY

# Encrypt the AUDIT trail's metadata and source IPs, also with RULEMIND_CONFIG_KEY.
# audit_events.metadata_json carries the emails, usernames and source IPs of failed sign-ins,
# invitations and role changes -- it was the last plaintext PII column in the schema while the
# decisions beside it were already opaque. Turn this off only for a plaintext-required
# migration. Existing plaintext rows keep reading either way; re-encrypting them onto the
# current key is scripts/rotate_config_key.py's job (it covers audit_events).
AUDIT_ENCRYPT_AT_REST=1

# Publish Swagger UI, ReDoc and the OpenAPI schema. OFF automatically when RULEMIND_ENV is
# production/prod/staging; this re-enables them for a deployment that deliberately wants a
# public API reference.
#
# They used to be on unconditionally, so the deployed API served /docs, /redoc and
# /openapi.json to anyone, unauthenticated: the complete endpoint map, every request and
# response schema, and the shape of the decisioning model. That is reconnaissance an attacker
# would otherwise have to guess at.
RULEMIND_ENABLE_DOCS=0
DECISION_WAL=0                           # 1 = durable write-ahead log for decisions
# default: <cwd>/.runtime/wal
DECISION_WAL_DIR=
# Replay attempts before a WAL decision that cannot re-insert is moved to the dead-letter file
# (<DECISION_WAL_DIR>/dead_letter_decisions.jsonl) instead of being retried on every boot. It is
# never deleted: a WAL record is a decision already returned to a caller and absent from the DB.
DECISION_WAL_MAX_REPLAY_ATTEMPTS=5
# none | discard | clickhouse | s3   (memory is tests only)
#
# THIS VARIABLE GATES THE WHOLE RETENTION JOB, not just archiving. scheduler.py's
# archive_old_decisions returns early unless a sink is set, so with the default `none`
# NOTHING IS EVER PURGED -- while settings.audit_retention_days defaults to 90 and the settings
# screen renders it as "Audit Retention Days". A workspace that set a retention window believes
# data older than it is gone; it is not.
#
# Measured on the soak stack: 13.2 KB per decision row (trace 6.1 KB, rule_results 2.5 KB,
# computed_variables 1.6 KB, scorecard_result 1.1 KB). 1M decisions/day is ~13 GB/day, forever.
# Size your volume for the retention window you intend, and set a sink so that window is real.
#
# `discard` purges without keeping a copy -- for deployments that want their retention window
# honoured and do not want a data warehouse. It is irreversible and there is no archive to
# restore from, which is why it must be chosen explicitly rather than being what `none` does.
# `clickhouse` and `s3` lazy-import clients that are NOT in requirements.txt; see the note on
# DecisionArchiver.available() before choosing one.
DECISION_ARCHIVE_SINK=none
DECISION_ARCHIVE_INTERVAL_HOURS=24
# Archive sink settings. The archiver reads these through an alias of os.environ, so until
# 2026-09-24 the config gate could not see them and they were documented nowhere.
#   DECISION_ARCHIVE_SINK=s3
DECISION_ARCHIVE_S3_BUCKET=
DECISION_ARCHIVE_S3_PREFIX=rulemind/decisions
DECISION_ARCHIVE_S3_FORMAT=jsonl                 # jsonl | parquet (parquet needs pyarrow)
DECISION_ARCHIVE_S3_ENDPOINT=                    # S3-compatible endpoint (MinIO, GCS); empty = AWS
DECISION_ARCHIVE_S3_REGION=                      # falls back to AWS_REGION
AWS_REGION=
#   DECISION_ARCHIVE_SINK=clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=rulemind_decisions
CLICKHOUSE_PREDICTOR_TABLE=rulemind_predictor_values
OUTBOX_RETRY_SECONDS=60

# ── Kafka delivery (app/decision_outbox.py, app/decision_consumer.py) ─────────
# Leave KAFKA_BOOTSTRAP_SERVERS unset and the transactional outbox still records every event in
# Postgres in the SAME transaction as the decision -- you lose DELIVERY, never data. Set it and
# the leader-gated relay starts publishing. A blank value is worse than an absent one:
# `decision_outbox.enabled()` tests `bool(os.getenv(...))`, so "" reads as configured-and-broken.
KAFKA_BOOTSTRAP_SERVERS=
RULEMIND_KAFKA_TOPIC=
RULEMIND_KAFKA_DLQ_TOPIC=
RULEMIND_KAFKA_GROUP=
RULEMIND_KAFKA_CLIENT_ID=rulemind-relay
# How often the leader-elected relay drains the outbox to Kafka.
DECISION_OUTBOX_RELAY_SECONDS=5

# Live decision feed (SSE)
DECISION_STREAM_BACKLOG=25
DECISION_STREAM_POLL_SECONDS=1.0
DECISION_STREAM_MAX_SECONDS=3600

# ---------------------------------------------------------------------------
# Engine performance
# ---------------------------------------------------------------------------
# Measured on PostgreSQL 16, 4 uvicorn workers, rate limiting off, concurrency 32:
#   defaults ............................... ~107 req/s   p50  246 ms
#   COMPUTE_ONLY_USED_VARS=1 ............... ~151 req/s   p50  199 ms
#   + FAST_DECIDE=1 ........................ ~207 req/s   p50  132 ms
# Throughput scales with worker PROCESSES, not with request concurrency — a single
# worker plateaus near 47 req/s however many requests you throw at it, and the extra
# concurrency turns into latency. Size replicas as (target rps / ~50) at defaults.
# Both flags below are correctness-preserving: outcome distributions were identical
# across every configuration and concurrency level measured.
FAST_DECIDE=0                            # 1 = compiled fast path
FAST_CACHE_EPOCH_TTL=1.0
COMPUTE_ONLY_USED_VARS=0                 # 1 = skip variables a policy never reads
SIM_MAX_WORKERS=32
SIMULATION_JSONL_MAX=50000
SDK_DECISIONS_BATCH_MAX=1000
REPORT_MAX_ROWS=100000
ANALYTICS_WINDOW_DAYS=90

# ---------------------------------------------------------------------------
# Python sandbox (user-authored variables)
# ---------------------------------------------------------------------------
SANDBOX_MODE=pool                        # pool | inline
SANDBOX_POOL_SIZE=4
# WAS `inline` here, against a code default of `fail` (app/sandbox.py:459). This is the
# behaviour when no sandbox subprocess is available: `fail` refuses to evaluate the variable,
# `inline` runs untrusted customer Python INSIDE the API process. Shipping `inline` in the file
# an operator copies re-enables exactly the posture the code default was changed to stop --
# silently, and only under the load that exhausts the pool, which is the worst time to discover
# your isolation boundary is advisory.
SANDBOX_FALLBACK_MODE=fail               # fail | inline -- read the note above
# Compiled-variable cache entries per sandbox subprocess.
SANDBOX_CODE_CACHE_SIZE=2048
# A decision's variables in ONE sandbox round trip, each still with its own timeout, isolation
# and error (app/sandbox.py). 1 is the default; 0 restores one trip per variable, which is slower
# (12.6 vs 6.8 ms p50 per decision on the seeded catalog) and exists as a kill switch.
SANDBOX_BATCH=1
# RLIMIT_AS per sandbox subprocess, in MB. Unset = no address-space cap. Unsettable on darwin
# (see app/sandbox.py:155) -- a Linux deployment gets the limit, a macOS dev box does not.
SANDBOX_MEMORY_MB=
PYTHON_SANDBOX_TIMEOUT=2000              # ms
PYTHON_SANDBOX_MEMORY=128                # MB

# ---------------------------------------------------------------------------
# ML model workers (app/model_executor.py) -- a SEPARATE pool from the sandbox above
# ---------------------------------------------------------------------------
MODEL_POOL_SIZE=2
MODEL_TIMEOUT_MS=5000
# Address-space cap per model worker. Do NOT lower this below ~768 MB: numpy + scipy +
# scikit-learn reserve large virtual regions just to import, and below the floor the worker
# cannot map its shared objects at all -- model upload returns 422 and every `model` policy
# step fails. The in-code default was 512 for a while, which was under the floor and broke
# every Linux deployment; it was invisible locally because darwin REFUSES setrlimit(RLIMIT_AS)
# and the cap is silently never applied there. app/model_executor.py carries the bisection.
MODEL_MEMORY_MB=2048
# Pickle is the only hosted-model format whose LOAD runs code. 0 refuses pickles at upload and
# at scoring; ONNX, PMML, XGBoost JSON and LightGBM files are unaffected. Default on, because
# existing installs hold pickled models.
MODEL_ALLOW_PICKLE=1
# Wall clock for one batch-scoring worker call (2,000 rows) during a model evaluation.
MODEL_BATCH_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Decision-time connector fetch  (app/connector_fetch.py)
# ---------------------------------------------------------------------------
# Platform ceilings for a connector that opted into being retrieved at decision time
# (config.fetch_at_decision). They CLAMP the per-connector settings rather than replacing
# them, and they live here rather than in tenant settings because the evaluation budget a
# tenant can raise must not be able to widen them.
RULEMIND_CONNECTOR_FETCH_MAX_TIMEOUT_MS=8000
RULEMIND_CONNECTOR_FETCH_MAX_RETRIES=2
RULEMIND_CONNECTOR_FETCH_MAX_BODY_BYTES=1048576
RULEMIND_CONNECTOR_FETCH_CACHE_ENTRIES=512
# Ceiling on how STALE the data behind a decision may be. Per-connector `cache_ttl_ms`
# defaults to 0 (no caching) and is clamped to this.
RULEMIND_CONNECTOR_MAX_CACHE_TTL_MS=300000

# ---------------------------------------------------------------------------
# Resilience, security, scheduling
# ---------------------------------------------------------------------------
CIRCUIT_BREAKER=1

# How often the leader drops consumed SAML assertions whose validity window has passed.
# The table takes one row per successful SSO login and is only ever read to reject a replay,
# so without this sweep it grows forever -- and that lookup is on the login path, so the cost
# lands on authentication.
SAML_PRUNE_INTERVAL_HOURS=6

# ---------------------------------------------------------------------------
# Rate limiting  (app/rate_limit.py)
# ---------------------------------------------------------------------------
# Token bucket per tenant, evaluated in Redis via a Lua script so it stays correct
# across replicas. Limits resolve most-specific-first:
#   1. per tenant   tenant.config["rate_limit_rpm"]
#   2. per plan     RATE_LIMIT_RPM_<PLAN>
#   3. global       RATE_LIMIT_RPM
#   4. built-in     enterprise 5000 / growth 2000 / standard 1000 / free 120
RATE_LIMIT_ENABLED=1
# 0 disables limiting entirely — use this for load tests and benchmarks, so the
# limiter does not shape the numbers you are trying to measure.

# Requests per minute for every plan without its own setting.
RATE_LIMIT_RPM=1000

# Per-plan overrides. The suffix is the plan name upper-cased.
RATE_LIMIT_RPM_ENTERPRISE=5000
RATE_LIMIT_RPM_STANDARD=1000
# RATE_LIMIT_RPM_GROWTH=2000
# RATE_LIMIT_RPM_FREE=120

# ── Usage quota (app/quota.py) ────────────────────────────────────────────────
# Metering is ALWAYS ON and needs no configuration -- decision volume accrues into
# usage_records regardless of these settings. What is configured here is ENFORCEMENT.
#
# Off by default on purpose: turning this on rejects traffic, so an upgrade must not
# start refusing decisions against a limit nobody chose. Watch real numbers at
# GET /api/v1/usage first, set limits against them, then enable.
#
# Distinct from RATE_LIMIT above: a quota is a BILLING boundary ("have you paid for
# this volume?"), rate limiting is a burst control ("are you sending it too fast?").
# Exceeding a quota returns 402 Payment Required, not 429 -- backing off cannot restore
# an allowance before the calendar month rolls over.
QUOTA_ENFORCE=0

# ── Process count ─────────────────────────────────────────────────────────────
# uvicorn --workers, read by the Dockerfile CMD rather than by Python -- which is why it was
# absent from this file while being the single largest throughput lever measured (2 -> 4 workers
# took 109.9 rps to 140.8 rps on a 4-core box).
#
# Each worker is a separate DB pool AND a separate copy of the ML stack in RAM, and each forks
# SANDBOX_POOL_SIZE + MODEL_POOL_SIZE subprocesses of its own. At the defaults that is
# 2 x (1 + 4 + 2) = 14 processes. Check the connection budget before raising it:
# workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay under Postgres max_connections.
RULEMIND_WORKERS=2

# ── Outbound webhook delivery (app/webhook_dispatch.py) ──────────────────────
# Every event is written to `webhook_deliveries` BEFORE it is sent, so a restart, a SIGTERM or
# a rolling deploy mid-delivery loses nothing: a leader-gated drain finishes it. Failures retry
# with backoff (10s, 30s, 2m, 10m, 30m, 2h, 6h -- ~9 hours end to end) and then land in a
# dead-letter state you can list (GET .../deliveries?status=dead) and replay
# (POST /api/v1/webhook-deliveries/{id}/redeliver). Delivery is at-least-once; the delivery id is
# sent so a receiver can dedupe.
WEBHOOK_MAX_ATTEMPTS=8
# A delivery claimed by a process that died mid-send is reclaimed after this long.
WEBHOOK_CLAIM_TIMEOUT_SECONDS=300
WEBHOOK_DRAIN_SECONDS=15
WEBHOOK_DRAIN_BATCH=100

# ── Stuck-execution sweep (app/scheduler.py) ─────────────────────────────────
# A multi-step policy that pauses -- on a review_gate, or for an SDK client resuming at the
# edge -- writes a durable workflow_executions row. If whatever was going to resume it goes
# away (the review task deleted, the queue drained, a client that never came back) the row sits
# paused forever. The sweep finds those and files an error event naming the count and the
# oldest, so they appear in GET /api/v1/audit/errors instead of being undiscoverable.
#
# It REPORTS, it does not expire. A paused execution holds a real decision in flight, and a
# sweeper that guessed wrong about "orphaned" would abandon a live case. Set
# EXECUTION_SWEEP_EXPIRE=1 to also mark them `expired`; off by default for the same reason
# DECISION_ARCHIVE_SINK defaults to `none` -- a destructive default silently changes what an
# upgrade does to data already in the table.
#
# Executions with an OPEN review task are excluded: those are waiting, not stuck, and
# check_review_timeouts already owns them.
EXECUTION_SWEEP_AFTER_MINUTES=1440
EXECUTION_SWEEP_INTERVAL_MINUTES=60
EXECUTION_SWEEP_EXPIRE=0

# ── Deployment environment ────────────────────────────────────────────────────
# Set this to `production` on any real deployment.
#
# app/security_config.py refuses to boot when the built-in development secrets are still in
# use -- but that check is SKIPPED for local dev, and the "is this local dev?" test used to
# read NODE_ENV with a default of "development". So a deployment that simply never set
# NODE_ENV skipped the check entirely and booted with the four known-public defaults. That
# path now warns loudly, and RULEMIND_ENV is the explicit signal that overrides it.
# RULEMIND_ENV=production

# Optional workspace scope for Anthropic calls (app/ai.py). Unset for a personal key.
ANTHROPIC_WORKSPACE_ID=

# ── Anthropic identity-linked keys ────────────────────────────────────────────
# Anthropic's newer identity-linked API keys are scoped to a workspace and REJECT any
# request that does not name one:
#   400 invalid_request_error: anthropic-workspace-id is required when authenticating
#   with an identity-linked API key
# Classic keys ignore the header, so setting this is safe either way. It can also be stored
# per workspace via PUT /api/v1/ai/config ({"anthropic": {"workspace_id": "..."}}), which
# takes precedence; this env var is the deployment-wide fallback.
# Find it in the Anthropic Console under Settings -> Workspaces (looks like wrkspc_...).
# ANTHROPIC_WORKSPACE_ID=

# Monthly decision allowance. Resolution order, most specific first:
#   1. per tenant   Tenant.config["quota"]["decisions_per_month"]
#   2. per plan     QUOTA_DECISIONS_<PLAN>
#   3. global       QUOTA_DECISIONS_DEFAULT
#   4. built-in     app/quota.py DEFAULT_PLAN_DECISIONS
# 0 means UNLIMITED.
# QUOTA_DECISIONS_DEFAULT=500000
# QUOTA_DECISIONS_ENTERPRISE=0
# QUOTA_DECISIONS_GROWTH=5000000
# QUOTA_DECISIONS_STANDARD=500000
# QUOTA_DECISIONS_FREE=10000

# Bucket capacity = rpm x this. 1.0 means burst == the per-minute budget; raise it
# to absorb short spikes without raising the sustained rate.
RATE_LIMIT_BURST_MULTIPLIER=1.0

# The window the rpm figure is expressed over. 60 = "per minute".
RATE_LIMIT_WINDOW_SECONDS=60

# Paths that are never limited. Default: /health /ready /metrics /api/v1/health
# /sdk/v1/health — a 429 on a health check reads as an outage to a load balancer.
# Setting this REPLACES the default list.
RATE_LIMIT_EXEMPT_PATHS=

# empty = fail CLOSED when Redis is down (recommended)
RATE_LIMIT_FAIL_OPEN=
API_KEY_CACHE_TTL=300
# Where this install runs, as you would state it to a regulator (e.g. in-mumbai-1, eu-frankfurt).
# Reported by GET /api/v1/data-residency; declared, never inferred. Empty = not declared.
RULEMIND_DATA_REGION=
# Mutual TLS for the SDK surface, terminated at a proxy that forwards the client certificate.
MTLS_MODE=off                                    # off | optional | required
MTLS_CERT_HEADER=x-client-cert
MTLS_VERIFY_HEADER=x-client-verify
MTLS_REQUIRE_PROXY_VERIFY=0                      # 1 = also require the proxy's verify header to say SUCCESS
MTLS_ALLOWED_FINGERPRINTS=                       # comma-separated SHA-256 fingerprints; empty = any valid cert
MTLS_PROTECTED_PREFIXES=/sdk/v1
# Escape hatches for the production secret check. Do NOT set these on a real deployment: they let
# the API start with the built-in, publicly known development secrets.
# RULEMIND_ALLOW_DEFAULT_SECRETS=               # comma-separated secret names allowed to keep their default
# RULEMIND_SKIP_SECRET_CHECK=0
# Lifetime of an OAuth2 access token from POST /api/v1/oauth/token (client credentials: the
# key's kid as client_id, the key as client_secret). Clamped to 60..86400. A token dies with its
# key regardless -- revoking the key revokes its tokens within API_KEY_CACHE_TTL.
OAUTH2_ACCESS_TOKEN_TTL_SECONDS=3600
# comma-separated payload keys to redact from logs
RULEMIND_PII_REDACT_KEYS=
# set to run the scheduler inside the API process
RULEMIND_RUN_API_SCHEDULER=
SCHEDULER_LEASE_TTL=30                   # leader-election lease, seconds
SLO_CHECK_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Onboarding / bundles / public URLs
# ---------------------------------------------------------------------------
RULEMIND_SEED_DEMO=0                     # 1 = seed demo data (several test suites require this)
# override SDK edge-bundle output dir
# Require an X-Client-Public-Key header on /sdk/v1/bundle. With it set, a device
# without a keypair is refused (400) instead of receiving an unencrypted bundle.
# Bundles are always RSA-signed and always travel over TLS regardless.
SDK_BUNDLE_REQUIRE_CLIENT_KEY=0

RULEMIND_BUNDLE_PATH=
# absolute URL used in generated snippets / callbacks
RULEMIND_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Observability (tracing activates only when the endpoint is set)
# ---------------------------------------------------------------------------
# e.g. http://localhost:4317 (compose profile: http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rulemind-api

# ---------------------------------------------------------------------------
# Web dashboard (apps/web — Next.js, build/runtime)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_RULEMIND_DEV_API_KEY=

# ---------------------------------------------------------------------------
# docker-compose only (consumed by the compose file, not by the app)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=rulemind
RULEMIND_API_PORT=8080
RULEMIND_WEB_PORT=3000
RULEMIND_API_ORIGIN=http://localhost:8080
RULEMIND_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Removed — previously listed here but read by nothing:
#   MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY / MINIO_BUCKET
#   DECISION_TIMEOUT_MS, AUDIT_RETENTION_DAYS
#
# LOG_LEVEL and RATE_LIMIT_RPM used to be on this list and are NOT unread — the file
# contradicted itself, listing RATE_LIMIT_RPM as removed while documenting it above with its
# full precedence order. RATE_LIMIT_RPM is read at app/rate_limit.py:134 and LOG_LEVEL at
# app/logging_config.py:140 (that module did not exist when the list was written). Both are
# documented in their own sections above.
# ---------------------------------------------------------------------------

# Outbound webhook subscriptions (P03)
# Maximum subscriptions per workspace. Each one multiplies the outbound requests a single event
# produces, so this is a fan-out bound rather than a licensing limit.
RULEMIND_WEBHOOK_MAX_SUBSCRIPTIONS=50

# Outbound client certificates (P02) are configured PER CONNECTOR, not by environment variable:
#   config.client_cert_p12         base64 of a .p12/.pfx bundle
#   config.client_cert_passphrase  its passphrase, if any
# Both are encrypted at rest with RULEMIND_CONFIG_KEY like every other connector secret.

# Automatically halt a running experiment whose challenger breaches its guardrails (P11).
# OFF by default: an automated halt is correct behaviour and a surprising one to inherit silently
# on upgrade -- a workspace mid-experiment would find it stopped by a job it never enabled.
EXPERIMENT_AUTO_ROLLBACK=0
EXPERIMENT_AUTO_ROLLBACK_MINUTES=10
# Predictor values are fanned out to the same sink (P10/P20). ClickHouse writes them to their own
# narrow table; S3 inherits the interface's no-op and receives decisions only.
CLICKHOUSE_PREDICTOR_TABLE=rulemind_predictor_values
