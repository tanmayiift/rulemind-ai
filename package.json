{
  "name": "rulemind-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @rulemind/web build && pnpm --filter @rulemind/python-executor build",
    "dev": "pnpm --parallel --filter @rulemind/web --filter @rulemind/python-executor dev",
    "lint": "pnpm -r lint",
    "start": "pnpm --filter @rulemind/python-executor start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @rulemind/python-executor migrate",
    "openapi": "pnpm --filter @rulemind/python-executor openapi"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "vite@<7.3.5": "7.3.6",
      "postcss@<8.5.23": "8.5.28",
      "nanoid@<3.3.18": "3.3.18",
      "esbuild@<0.28.1": "0.28.2"
    }
  }
}
