# Provider key for the opt-in live-AI suite (#123). COPY THIS FILE TO `.env.ai` AND PASTE THE
# KEY THERE -- `.env.ai` is gitignored (`.env.*` in .gitignore), this file is not.
#
#   cp .env.ai.example .env.ai
#   $EDITOR .env.ai          # paste the key, save
#   bash scripts/run_ai_live.sh
#
# The key is READ FROM THIS FILE INTO THE ENVIRONMENT and never written anywhere else: not to
# a log, not to the test output, not into the repo's SQLite. The suite does hand it to
# `storage.set_ai_config`, which is the real BYO-key path and encrypts it at rest with
# RULEMIND_CONFIG_KEY -- that write goes to a TEMPORARY database the suite deletes on exit.
#
# THESE CALLS COST MONEY. Six generation endpoints, a handful of requests each. That is why the
# suite is opt-in rather than part of the gate.

# openai | anthropic | gemini
RULEMIND_AI_LIVE_PROVIDER=openai

# Paste the key on the next line, after the `=`, with no quotes and no trailing spaces.
RULEMIND_AI_LIVE_KEY=

# Optional: pin a model instead of the provider default. Leave blank for the default.
RULEMIND_AI_LIVE_MODEL=
