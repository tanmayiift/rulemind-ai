# Copy to .env.deployed (gitignored) and fill in the key.
#   Render dashboard -> rulemind-api -> Environment -> RULEMIND_DEV_API_KEY
# Nothing that reads this file ever echoes the key.
RULEMIND_DEPLOYED_API=https://rulemind-api.onrender.com
RULEMIND_DEPLOYED_WEB=https://rulemind-dashboard.onrender.com
RULEMIND_DEPLOYED_API_KEY=
